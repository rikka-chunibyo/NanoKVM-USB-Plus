{
  "name": "nanokvm-usb-plus",
  "version": "1.1.4",
  "description": "NanoKVM-USB Plus Desktop",
  "main": "./out/main/index.js",
  "author": "rikka-chunibyo",
  "homepage": "https://github.com/rikka-chunibyo/NanoKVM-USB-Plus",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --publish never --dir",
    "build:win": "npm run build && electron-builder --publish never --win nsis --x64",
    "build:mac": "npm run build && electron-builder --publish never --mac dmg zip --x64",
    "build:linux": "npm run build && electron-builder --publish never --linux AppImage --x64",
    "build:win-full": "npm run build && electron-builder --publish never --win nsis --x64 --arm64",
    "build:mac-full": "npm run build && electron-builder --publish never --mac dmg zip --x64 --arm64",
    "build:linux-full": "npm run build && electron-builder --publish never --linux AppImage --x64 --arm64"
  },
  "build": {
    "appId": "com.rikka-chunibyo.nanokvm-usb-plus",
    "productName": "NanoKVM-USB Plus",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/serialport/**",
      "**/node_modules/@serialport/**",
      "**/node_modules/bindings/**",
      "**/node_modules/node-gyp-build/**"
    ],
    "files": [
      "out/**/*",
      "!out/**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "NanoKVM-USB-Plus"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSCameraUsageDescription": "NanoKVM-USB Plus uses the KVM video capture device.",
        "NSMicrophoneUsageDescription": "NanoKVM-USB Plus uses the KVM audio capture device."
      },
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true,
      "notarize": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NanoKVM-USB Plus",
      "artifactName": "NanoKVM-USB-Plus-${version}-${os}-${arch}-setup.${ext}"
    },
    "buildDependenciesFromSource": false,
    "npmRebuild": false,
    "artifactName": "NanoKVM-USB-Plus-${version}-${os}-${arch}.${ext}",
    "dmg": {
      "sign": false
    },
    "afterSign": "./notarize.js",
    "publish": {
      "provider": "github",
      "owner": "rikka-chunibyo",
      "repo": "NanoKVM-USB-Plus"
    }
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@tailwindcss/vite": "^4.0.6",
    "antd": "^5.29.3",
    "clsx": "^2.1.1",
    "electron-log": "^5.3.1",
    "electron-updater": "^6.3.9",
    "i18next": "^24.2.2",
    "jotai": "^2.12.1",
    "lucide-react": "^0.476.0",
    "monaco-editor": "^0.57.0",
    "react-draggable": "^4.5.0",
    "react-i18next": "^15.4.1",
    "react-responsive": "^10.0.0",
    "react-simple-keyboard": "^3.8.49",
    "serialport": "^13.0.0",
    "tailwindcss": "^4.0.6",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/notarize": "^2.5.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.4.1",
    "electron-builder": "^26.7.0",
    "electron-vite": "^4.0.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "prettier": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "electronRebuildConfig": {
    "buildFromSource": false
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rikka-chunibyo/NanoKVM-USB-Plus"
  }
}
